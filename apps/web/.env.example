# Copy to .env.local. NEXT_PUBLIC_* values are inlined into the browser bundle, so never
# put a secret in one. MONAD_RPC_URL stays server-side (used by app/api/rpc).

# mainnet (default) | testnet | local
NEXT_PUBLIC_CHAIN=mainnet

# Deployed addresses, printed by script/Deploy.s.sol
NEXT_PUBLIC_STREAM_VAULT=
NEXT_PUBLIC_HANDLE_REGISTRY=

# Server-side only. Where the RPC proxy forwards to.
MONAD_RPC_URL=https://rpc.monad.xyz
