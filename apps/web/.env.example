# Copy to .env.local. NEXT_PUBLIC_* values are inlined into the browser bundle, so never
# put a secret in one. MONAD_RPC_URL and RELAYER_PRIVATE_KEY stay server-side.

# mainnet (default) | testnet | local
NEXT_PUBLIC_CHAIN=mainnet

# Deployed addresses, printed by script/Deploy.s.sol or tools/local-dev.sh
NEXT_PUBLIC_STREAM_VAULT=
NEXT_PUBLIC_HANDLE_REGISTRY=

# Optional. Overrides the verified AUSD/USDC addresses in lib/config.ts. Only needed for
# local development, where test/mocks/MockAUSD.sol stands in for the real token — the
# real AUSD has a permissioned mint and there is no public faucet.
NEXT_PUBLIC_AUSD_ADDRESS=
NEXT_PUBLIC_USDC_ADDRESS=

# Server-side only. Where the RPC proxy (app/api/rpc) and the relay forward to.
MONAD_RPC_URL=https://rpc.monad.xyz

# Server-side only, and deliberately NOT prefixed NEXT_PUBLIC_ so it can never be
# inlined into a client bundle. The key that pays gas for other people's permits.
#
# Without it the relay returns 503 and the app falls back to making the payer broadcast
# their own permit — which means the payer needs MON, and the UI says so rather than
# continuing to claim the flow is gasless.
#
# This key only ever pays gas. It cannot move anyone's funds: createStreamWithPermit
# takes the payer as an argument and the EIP-2612 signature binds owner, spender, value
# and deadline, so the relayer cannot alter the terms it is relaying.
RELAYER_PRIVATE_KEY=
